{% extends 'base.html.twig' %}

{% block title %}Złożenia – Kokpit JDG{% endblock %}

{% block body %}
    <h1>Złożenia i okresy</h1>
    <nav><a href="{{ path('panel_dashboard') }}">Start</a> · <a href="{{ path('panel_ledger') }}">Ewidencja</a> · <a href="{{ path('panel_taxes') }}">Podatki</a></nav>
    {% for message in app.flashes('notice') %}<p role="status">{{ message }}</p>{% endfor %}
    {% if error %}<p role="alert">{{ error }}</p>{% endif %}
    <p>Zmiany na tej stronie wymagają potwierdzenia passkeyem (ważne 5 minut).</p>
    <button id="passkey-step-up" type="button" data-csrf="{{ csrf_token('passkey') }}">Potwierdź passkeyem</button>
    <p id="passkey-result" role="status"></p>

    <section id="filing-manual">
        <h2>Złożenie poza kokpitem</h2>
        <p>JPK_V7M albo VAT-UE złożony w narzędziu MF. Kokpit zapisuje go jako przyjęty, z UPO, bez zatwierdzenia. Przyjęty JPK_V7M zamyka okres; korektę zapiszesz po ponownym otwarciu.</p>
        <form method="post" action="{{ path('panel_filings_manual') }}" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('filings') }}">
            <label>Rodzaj <select name="type"><option value="JPK_V7M">JPK_V7M</option><option value="VAT_UE">VAT-UE</option></select></label>
            <label>Miesiąc <input name="month" placeholder="RRRR-MM" pattern="\d{4}-\d{2}" required></label>
            <label>UPO (PDF albo XML) <input type="file" name="upo" required></label>
            <label>Plik JPK_V7M (XML, źródło P_62) <input type="file" name="jpk"></label>
            <label>P_62 w złotych (gdy bez pliku) <input name="p62" inputmode="numeric"></label>
            <label>Numer referencyjny <input name="reference_number" maxlength="128"></label>
            <button type="submit">Zapisz złożenie</button>
        </form>
    </section>

    <section id="filing-periods">
        <h2>Okresy</h2>
        {% if periods is empty %}<p>Brak okresów.</p>{% else %}
        <table>
            <thead><tr><th>Miesiąc</th><th>Stan</th><th>Ewidencja kompletna</th><th>Bramki kompletności</th><th>Akcja</th></tr></thead>
            <tbody>
            {% for period in periods %}
                <tr><td>{{ period.period_start|slice(0, 7) }}</td><td>{{ {'open': 'otwarty', 'closed': 'zamknięty', 'reopened': 'otwarty ponownie'}[period.status] }}</td>
                    <td>{{ period.ledger_closed_at ? 'tak' : 'nie' }}</td>
                    <td>{% if period.checklist is null %}–{% elseif period.checklist.ok %}spełnione{% else %}<span role="alert">niespełnione: {% for gate, result in period.checklist.gates %}{% if not result.ok %}{{ {'sales_final': 'faktury sprzedaży nie w stanie końcowym', 'costs_reviewed': 'koszty bez przeglądu albo okresu', 'fx_rates': 'brak kursu VAT albo PIT', 'vies_eu_b2b': 'sprzedaż eu_b2b bez VIES'}[gate] }} ({{ result.count }}) {% endif %}{% endfor %}</span>{% endif %}</td>
                    <td>{% if period.status == 'closed' %}
                        <form method="post" action="{{ path('panel_filings_reopen', {month: period.period_start|slice(0, 7)}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('filings') }}">
                            <label>Powód <input name="reason" maxlength="500" required></label>
                            <button type="submit">Otwórz ponownie</button>
                        </form>
                    {% elseif period.status == 'reopened' %}
                        <p>Powód otwarcia: {{ period.reopen_reason }}</p>
                        <form method="post" action="{{ path('panel_filings_reclose', {month: period.period_start|slice(0, 7)}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('filings') }}">
                            <label>Powód zamknięcia bez korekty <input name="reason" maxlength="500" required></label>
                            <button type="submit">Zamknij bez korekty</button>
                        </form>
                    {% endif %}</td></tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </section>

    <section id="filing-list">
        <h2>Złożenia</h2>
        {% if filings is empty %}<p>Brak złożeń.</p>{% else %}
        <table>
            <thead><tr><th>Rodzaj</th><th>Miesiąc</th><th>Cel</th><th>Stan</th><th>Droga</th><th>Numer referencyjny</th><th>Przyjęte</th></tr></thead>
            <tbody>
            {% for filing in filings %}
                <tr><td>{{ filing.type }}</td><td>{{ filing.period_start|slice(0, 7) }}</td><td>{{ filing.purpose == 1 ? 'złożenie' : 'korekta ' ~ filing.seq }}</td><td>{{ filing.status }}</td><td>{{ filing.submitted_via }}</td><td>{{ filing.reference_number }}</td><td>{{ filing.accepted_at }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </section>
{% endblock %}
