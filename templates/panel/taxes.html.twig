{% extends 'base.html.twig' %}

{% block title %}Podatki – Kokpit JDG{% endblock %}

{% block body %}
    <h1>Podatki {{ year }}</h1>
    <nav><a href="{{ path('panel_dashboard') }}">Start</a> · <a href="{{ path('panel_ledger') }}">Ewidencja</a> · <a href="{{ path('panel_settings') }}">Ustawienia</a></nav>
    {% for message in app.flashes('notice') %}<p role="status">{{ message }}</p>{% endfor %}
    {% if error %}<p role="alert">{{ error }}</p>{% endif %}

    <section id="ryczalt-eligibility-metric">
        <h2>Limit ryczałtu</h2>
        {% if eligibility is null %}<p>Czeka na tabelę A NBP z kursem EUR (pierwszy dzień roboczy października {{ year }}).</p>{% else %}
        <p>Przychód {{ year }}: <strong>{{ eligibility.revenue_pln }} zł</strong> = <strong>{{ eligibility.revenue_eur }} EUR</strong> (kurs {{ eligibility.rate }}, tabela {{ eligibility.rate_table }} z {{ eligibility.rate_date }}).</p>
        {% if eligibility.rate_estimated %}<p>Kurs szacunkowy: ustawa bierze kurs z {{ eligibility.rate_day }}, do tego dnia liczę po ostatniej tabeli.</p>{% endif %}
        {% if eligibility.watch_limit_eur %}<p>Wobec {{ eligibility.watch_limit_eur }} EUR z projektu ustawy (Q-38): {{ eligibility.watch_used_pct }}%.</p>{% endif %}
        {% if eligibility.limit_eur %}<p>Limit obowiązujący: {{ eligibility.limit_eur }} EUR.</p>{% else %}<p>Brak ustawienia ryczalt.eligibility.</p>{% endif %}
        {% endif %}
    </section>

    {% set limit_labels = {eligibility: 'limit prawa do ryczałtu w ' ~ (year + 1), eligibility_watch: 'limit z projektu ustawy (Q-38)', quarterly: 'wpłata co kwartał w ' ~ (year + 1)} %}
    <section id="threshold-forecast">
        <h2>Prognoza progów {{ year }}</h2>
        {% if forecast is null %}<p>Prognoza startuje po pierwszym zakończonym miesiącu roku.</p>{% else %}
        <p>Prognoza, nie porada: średnia z {{ forecast.basis_months }} zakończonych mies. (do {{ forecast.basis_end }}) to {{ forecast.run_rate_monthly }} zł miesięcznie.
            Przychód do {{ forecast.ytd_end }}: {{ forecast.revenue_ytd }} zł; prognoza roku: <strong>{{ forecast.projected_revenue }} zł</strong>.</p>
        {% if forecast.eur is null %}<p>Progi w euro czekają na tabelę A NBP.</p>{% else %}
        <table>
            <thead><tr><th>Próg</th><th>EUR</th><th>zł po kursie {{ forecast.eur.rate }}{% if forecast.eur.rate_estimated %} (szacunek){% endif %}</th><th>Stan</th></tr></thead>
            <tbody>
            {% for limit in forecast.eur.limits %}
                <tr><td>{{ limit_labels[limit.key] }}</td><td>{{ limit.limit_eur }}</td><td>{{ limit.limit_pln }}</td>
                    <td>{% if limit.crossed %}przekroczony w {{ limit.cross_month }}{% elseif limit.projected_cross %}prognoza: przekroczenie w {{ limit.cross_month }}{% else %}prognoza: bez przekroczenia{% endif %}</td></tr>
            {% else %}
                <tr><td colspan="4">Brak limitów w ryczalt.eligibility.</td></tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
        {% if forecast.health %}
        <p>Zdrowotna: przychód po składkach społecznych {{ forecast.health.revenue_after_social_ytd }} zł (próg {{ forecast.health.bracket_now }}), prognoza roku {{ forecast.health.projected_revenue_after_social }} zł (próg {{ forecast.health.bracket_projected }}).
            {% if forecast.health.next_limit_pln %}Granica progu {{ forecast.health.next_limit_pln }} zł: {% if forecast.health.next_cross_month %}przekroczenie w {{ forecast.health.next_cross_month }}{% else %}bez przekroczenia w roku{% endif %}.{% endif %}</p>
        {% else %}<p>Brak zus.parameters na ten rok: bez prognozy zdrowotnej.</p>{% endif %}
        <p id="tax-reserve">Do odłożenia dziś: <strong>{{ forecast.reserve.total }} zł</strong>
            {% if forecast.reserve.period_start %}(ryczałt narosły od {{ forecast.reserve.period_start }}: {{ forecast.reserve.ryczalt_open_period }} zł; {% else %}({% endif %}dopłata zdrowotnej za {{ forecast.health.months_paid ?? 0 }} zapłacone mies. przy progu z prognozy: {{ forecast.reserve.health_surcharge }} zł).</p>
        {% endif %}
    </section>

    <section id="ryczalt-advances">
        <h2>Zaliczki na ryczałt ({{ cadence == 'quarterly' ? 'co kwartał' : 'co miesiąc' }})</h2>
        {% if advances is empty %}<p>Brak zakończonych okresów.</p>{% else %}
        <table>
            <thead><tr><th>Okres</th><th>Przychód per stawka</th><th>Odliczenia (zapłacone + przeniesione)</th><th>Podstawa per stawka</th><th>Zaliczka</th><th>Nadwyżka dalej</th></tr></thead>
            <tbody>
            {% for item in advances %}
                <tr><td>{{ item.period_start|slice(0, 7) }}</td>
                    <td>{% for rate, amount in item.revenue %}{{ rate }}%: {{ amount }}{% if not loop.last %}; {% endif %}{% endfor %}</td>
                    <td>{{ item.paid_deductions }} + {{ item.carried_in }}</td>
                    <td>{% for rate, base in item.result.bases %}{{ rate }}%: {{ base }}{% if not loop.last %}; {% endif %}{% endfor %}</td>
                    <td>{{ item.result.advance }} zł</td><td>{{ item.result.carryover }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </section>

    <section id="zus-payments">
        <h2>Zapłacone składki ZUS</h2>
        <table>
            <thead><tr><th>Miesiąc</th><th>Społeczne</th><th>Zdrowotna</th><th>Bez odliczenia</th><th>Zapłacono</th></tr></thead>
            <tbody>
            {% for payment in payments %}<tr><td>{{ payment.month }}</td><td>{{ payment.social_pln }}</td><td>{{ payment.health_pln }}</td><td>{{ payment.other_pln }}</td><td>{{ payment.paid_on }}</td></tr>{% endfor %}
            </tbody>
        </table>
        <form method="post" action="{{ path('panel_taxes_zus_payment') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('taxes') }}">
            <label>Miesiąc składkowy <input name="month" type="month" required></label>
            <label>Społeczne <input name="social_pln" required pattern="[0-9]+\.[0-9]{2}"></label>
            <label>Zdrowotna <input name="health_pln" required pattern="[0-9]+\.[0-9]{2}"></label>
            <label>Bez odliczenia (np. FP) <input name="other_pln" required pattern="[0-9]+\.[0-9]{2}" value="0.00"></label>
            <label>Dzień zapłaty <input name="paid_on" type="date" required value="{{ today }}"></label>
            <button type="submit">Zapisz składki</button>
        </form>
    </section>

    {% if health %}
    <section id="health-reconciliation">
        <h2>Roczne rozliczenie zdrowotnej {{ year }}</h2>
        <p>Przychód po składkach społecznych {{ health.revenue_after_social }} zł, próg {{ health.bracket }}, {{ health.months }} mies.: należna {{ health.due }} zł, zapłacona {{ health.paid }} zł.</p>
        <p>{% if health.refund_task %}Nadpłata {{ health.difference|slice(1) }} zł: złóż RZS-R o zwrot.{% else %}Do dopłaty {{ health.amount_due }} zł do 20 maja.{% endif %}</p>
    </section>
    {% endif %}

    <section id="pit28-summary">
        <h2>Zestawienie PIT-28 {{ year }}</h2>
        <p>Liczby do przepisania w Twój e-PIT albo w formularzu PIT-28, liczone metodą części D–N PIT-28(27) (D-101); przy nowym wzorze sprawdź numery pozycji. Wpłaty zaliczek kreator ma z urzędu, a ryczałt miesięcy (część Q) to kolumna „Zaliczka” w tabeli zaliczek. Zeznanie składasz sam od 15 lutego do 30 kwietnia.</p>
        {% if pit28_refused %}
        <p id="pit28-refused" role="status">{{ pit28_refused }}</p>
        <table>
            <thead><tr><th>Stawka</th><th>Przychód</th></tr></thead>
            <tbody>
            {% for rate, amount in pit28.revenue %}<tr><td>{{ rate }}%</td><td>{{ amount }}</td></tr>{% endfor %}
            <tr><th>Razem</th><td>{{ pit28.revenue_total }}</td></tr>
            </tbody>
        </table>
        {% else %}
        <table id="pit28-rates">
            <thead><tr><th>Stawka</th><th>Przychód (D)</th><th>Udział % (D.7)</th><th>Społeczne (F.1)</th><th>50% zdrowotnej (F.2)</th><th>Po odliczeniach (G)</th><th>Podstawa w zł (K)</th><th>Ryczałt (L)</th></tr></thead>
            <tbody>
            {% for rate, row in pit28.rates %}
                <tr><td>{{ rate }}%</td><td>{{ row.revenue }}</td><td>{{ row.share }}</td><td>{{ row.social }}</td><td>{{ row.health }}</td><td>{{ row.net }}</td><td>{{ row.base }}</td><td>{{ row.ryczalt }}</td></tr>
            {% endfor %}
            <tr><th>Razem</th><td>{{ pit28.revenue_total }}</td><td></td><td>{{ pit28.social_deducted }}</td><td>{{ pit28.health_deducted }}</td><td></td><td>{{ pit28.base }}</td><td>{{ pit28.ryczalt }}</td></tr>
            </tbody>
        </table>
        <p id="pit28-due">Należny ryczałt (N): <strong>{{ pit28.ryczalt_due }} zł</strong>. Wpłacone zaliczki według kalendarza: {{ pit28.advances_paid }} zł; porównaj z wpłatami w kreatorze.</p>
        {% endif %}
        <p id="pit28-contributions">Składki społeczne zapłacone w roku: {{ pit28.social_paid }} zł{% if pit28.social_deductible is defined %}, do odliczenia (E.1, nie więcej niż przychód): {{ pit28.social_deductible }} zł{% endif %}; 50% zdrowotnej (E.4): {{ pit28.health_deductible }} zł.</p>
    </section>
{% endblock %}
