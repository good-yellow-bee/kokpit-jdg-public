{% extends 'base.html.twig' %}

{% block title %}Passkeye – Kokpit JDG{% endblock %}

{% block body %}
    <h1>Passkeye</h1>
    <nav><a href="{{ path('panel_dashboard') }}">Start</a></nav>
    {% for message in app.flashes('notice') %}<p role="status">{{ message }}</p>{% endfor %}
    {% if warning %}<p role="alert" id="passkey-warning">Masz tylko jeden passkey. Dodaj drugi na innym urządzeniu, żeby nie stracić dostępu.</p>{% endif %}
    <p>Dodanie i unieważnienie passkeya wymaga potwierdzenia passkeyem (step-up, ważne 5 minut).</p>
    <button id="passkey-step-up" type="button" data-csrf="{{ csrf_token('passkey') }}">Potwierdź passkeyem</button>
    <p id="passkey-result" role="status"></p>
    <ul>
        {% for passkey in passkeys %}
            <li>{{ passkey.label }}, dodany {{ passkey.created_at }}, ostatnio {{ passkey.last_used_at ?? 'nieużywany' }}
                <form method="post" action="{{ path('panel_passkey_revoke', {id: passkey.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('passkeys') }}">
                    <button type="submit">Unieważnij</button>
                </form>
            </li>
        {% endfor %}
    </ul>
    <form method="post" action="{{ path('panel_passkey_add') }}" id="passkey-add">
        <input type="hidden" name="_token" value="{{ csrf_token('passkeys') }}">
        <button type="submit">Dodaj passkey</button>
    </form>
    <script src="{{ asset('passkey.js') }}" defer></script>
{% endblock %}
