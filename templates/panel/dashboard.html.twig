{% extends 'base.html.twig' %}

{% block title %}Kokpit JDG{% endblock %}

{% block body %}
    <h1>Kokpit JDG</h1>
    {% if banner.visible %}
        <aside role="status">
            <strong>Tryb bezpieczny.</strong>
            {% if not banner.connectorsEnabled %}Konektory są wyłączone (CONNECTORS_ENABLED=0).{% endif %}
            Cele: {% for connector, target in banner.targets %}{{ connector }}: {{ target }}{% if not loop.last %}, {% endif %}{% endfor %}.
        </aside>
    {% endif %}
    {% if passkey_warning %}<p role="alert" id="passkey-warning">Masz tylko jeden passkey. <a href="{{ path('panel_passkeys') }}">Dodaj drugi</a> na innym urządzeniu.</p>{% endif %}
    {% if registry_alerts %}
        <section id="self-check-alerts" role="alert">
            <h2>Samosprawdzenie w rejestrach</h2>
            <ul>
                {% for alert in registry_alerts %}
                    <li>{{ {'status_not_active': 'Biała lista: status VAT inny niż „Czynny”.', 'account_not_listed': 'Biała lista: rachunek firmowy spoza wykazu.', 'vat_eu_invalid': 'VIES: Twój numer VAT UE jest nieważny.', 'vat_eu_unverified_retry': 'VIES: brak wyniku dla Twojego numeru VAT UE.'}[alert.code] ?? alert.code }}</li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
    <section id="upcoming-deadlines">
        <h2>Najbliższe terminy</h2>
        {% if upcoming %}
            <ol>
                {% for item in upcoming %}
                    <li><a href="{{ path('panel_calendar') }}#obligation-{{ item.id }}">{{ item.due_date }}</a>{% if item.overdue %} <strong>zaległy</strong>{% endif %}: {{ item.type }}{% if item.period_start %} ({{ item.period_start }}){% endif %}{% if item.note %}: {{ item.note }}{% endif %}{% if item.amount_due is not null %}, {{ item.amount_due }} zł{% elseif item.missing %}, {{ item.missing }}{% endif %}</li>
                {% endfor %}
            </ol>
            <p>Otwartych obowiązków: {{ open_obligations }}. <a href="{{ path('panel_calendar') }}">Cały kalendarz</a></p>
        {% else %}
            <p>Brak otwartych obowiązków. <a href="{{ path('panel_calendar') }}">Kalendarz</a></p>
        {% endif %}
    </section>
    <section id="connector-validity">
        <h2>Ważność poświadczeń</h2>
        {% if credentials %}
            <table>
                <thead><tr><th>Konektor</th><th>Poświadczenie</th><th>Stan</th><th>Ważne do</th></tr></thead>
                <tbody>
                {% for credential in credentials %}
                    <tr><td>{{ credential.connector }}</td><td>{{ credential.kind }}</td><td>{{ {'valid': 'ważne', 'expiring': 'wygasa', 'expired': 'wygasło', 'revoked': 'unieważnione'}[credential.status] ?? credential.status }}</td><td>{{ credential.valid_until ?? '—' }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>Brak zarejestrowanych poświadczeń.</p>
        {% endif %}
    </section>
    <p>Panel jest gotowy do bezpiecznego logowania passkeyem.</p>
    <nav><a href="{{ path('panel_approvals') }}">Zatwierdzenia</a> · <a href="{{ path('panel_calendar') }}">Kalendarz</a> · <a href="{{ path('panel_ledger') }}">Ewidencja</a> · <a href="{{ path('panel_taxes') }}">Podatki</a> · <a href="{{ path('panel_filings') }}">Złożenia</a> · <a href="{{ path('panel_year_close') }}">Zamknięcie roku</a> · <a href="{{ path('panel_freshbooks') }}">FreshBooks</a> · <a href="{{ path('panel_invoices') }}">Faktury</a> · <a href="{{ path('panel_costs') }}">Koszty</a> · <a href="{{ path('panel_payments') }}">Płatności</a> · <a href="{{ path('panel_reports') }}">Raporty</a> · <a href="{{ path('panel_chat') }}">Czat</a> · <a href="{{ path('panel_settings') }}">Ustawienia</a> · <a href="{{ path('panel_connectors') }}">Konektory</a> · <a href="{{ path('panel_passkeys') }}">Passkeye</a></nav>
{% endblock %}
