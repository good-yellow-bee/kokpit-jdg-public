{% extends 'base.html.twig' %}

{% block title %}Rejestracja passkeya{% endblock %}

{% block body %}
    <h1>Rejestracja passkeya</h1>
    <p>Dodajesz passkey dla: {{ display_name }}.</p>
    <button id="passkey-enrol" data-csrf="{{ csrf_token('passkey') }}" data-next="{{ app.user ? path('panel_passkeys') : path('panel_login') }}" type="button">Dodaj passkey</button>
    <p id="passkey-result" role="status"></p>
    <script src="{{ asset('passkey.js') }}" defer></script>
{% endblock %}
