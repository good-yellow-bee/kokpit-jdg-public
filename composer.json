{
    "name": "good-yellow-bee/kokpit-jdg",
    "description": "Osobisty kokpit JDG",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4 <8.5",
        "ext-pdo_pgsql": "*",
        "ext-sodium": "*",
        "anthropic-ai/sdk": "0.58.0",
        "brick/math": "^0.14",
        "doctrine/doctrine-bundle": "^2.18",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.5",
        "dompdf/dompdf": "^3.1",
        "dragonmantank/cron-expression": "^3.4",
        "endroid/qr-code": "^5.1",
        "nyholm/psr7": "^1.8",
        "psr/http-client": "^1.0",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/process": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stimulus-bundle": "^2.30",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/ux-turbo": "^2.30",
        "symfony/workflow": "7.4.*",
        "symfony/yaml": "7.4.*",
        "web-auth/webauthn-symfony-bundle": "^5.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "giorgiosironi/eris": "^1.0",
        "infection/infection": "^0.31",
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "DoctrineMigrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "infection/extension-installer": true,
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "scripts": {
        "check-licenses": "@php tools/check-licenses.php",
        "fixtures:scan": "@php scripts/scan-fixtures.php"
    },
    "conflict": {
        "symfony/error-handler": ">=8",
        "symfony/event-dispatcher": ">=8",
        "symfony/http-foundation": ">=8",
        "symfony/mime": ">=8",
        "symfony/password-hasher": ">=8",
        "symfony/routing": ">=8",
        "symfony/security-core": ">=8",
        "symfony/security-http": ">=8",
        "symfony/stopwatch": ">=8",
        "symfony/string": ">=8",
        "symfony/twig-bridge": ">=8",
        "symfony/type-info": ">=8",
        "symfony/validator": ">=8",
        "symfony/var-dumper": ">=8",
        "symfony/var-exporter": ">=8",
        "symfony/dom-crawler": ">=8",
        "symfony/options-resolver": ">=8"
    }
}
