										<xsd:documentation>Podstawa obliczenia ryczałtu od przychodów opodatkowanych stawką ryczałtu 2%</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 172 należy odjąć kwotę z poz. 185.-->
								</xsd:element>
								<xsd:element name="P_197" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podstawa obliczenia ryczałtu od przychodów opodatkowanych stawką ryczałtu 3%</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 173 należy odjąć kwotę z poz. 186.-->
								</xsd:element>
								<xsd:element name="P_198" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podstawa obliczenia ryczałtu od przychodów opodatkowanych stawką ryczałtu 5,5%</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 174 należy odjąć kwotę z poz. 187.-->
								</xsd:element>
								<xsd:element name="P_199" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podstawa obliczenia ryczałtu od przychodów opodatkowanych stawką ryczałtu 8,5%</xsd:documentation>
									</xsd:annotation>
									<!--Kwota z poz. 134, po zaokrągleniu do pełnych złotych.-->
								</xsd:element>
								<xsd:element name="P_200" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podstawa obliczenia ryczałtu od przychodów opodatkowanych stawką ryczałtu 8,5%</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 175 należy odjąć kwotę z poz. 188.-->
								</xsd:element>
								<xsd:element name="P_201" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podstawa obliczenia ryczałtu od przychodów opodatkowanych stawką ryczałtu 10%</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 176 należy odjąć kwotę z poz. 189.-->
								</xsd:element>
								<xsd:element name="P_202" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podstawa obliczenia ryczałtu od przychodów opodatkowanych stawką ryczałtu 12%</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 177 należy odjąć kwotę z poz. 190.-->
								</xsd:element>
								<xsd:element name="P_203" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podstawa obliczenia ryczałtu od przychodów opodatkowanych stawką ryczałtu 12,5%</xsd:documentation>
									</xsd:annotation>
									<!--Kwota z poz. 138, po zaokrągleniu do pełnych złotych.-->
								</xsd:element>
								<xsd:element name="P_204" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podstawa obliczenia ryczałtu od przychodów opodatkowanych stawką ryczałtu 12,5%</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 178 należy odjąć kwotę z poz. 191.-->
								</xsd:element>
								<xsd:element name="P_205" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podstawa obliczenia ryczałtu od przychodów opodatkowanych stawką ryczałtu 14%</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 179 należy odjąć kwotę z poz. 192.-->
								</xsd:element>
								<xsd:element name="P_206" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podstawa obliczenia ryczałtu od przychodów opodatkowanych stawką ryczałtu 15%</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 180 należy odjąć kwotę z poz. 193.-->
								</xsd:element>
								<xsd:element name="P_207" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podstawa obliczenia ryczałtu od przychodów opodatkowanych stawką ryczałtu 17%</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 181 należy odjąć kwotę z poz. 194.-->
								</xsd:element>
								<xsd:element name="P_208" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Przychody określone przez organ podatkowy na podstawie art. 17 ustawy po odliczeniach</xsd:documentation>
									</xsd:annotation>
									<!--W celu obliczenia przychodów określonych przez organ podatkowy na podstawie art. 17 ustawy po odliczeniach i objętych ryczałtem według różnych stawek należy przychody wykazane w poz. od 64 do 73 pomniejszyć o przysługujące od tych przychodów odliczenia, powiększyć o zwiększenia przypadające na te przychody, pomniejszyć o zmniejszenia przypadające na te przychody, pomniejszyć o wartość nieodliczonych w poprzednich latach wierzytelności i zobowiązań zmniejszających te przychody i zaokrąglić je do pełnych złotych, a następnie obliczone w ten sposób wielkości zsumować.-->
								</xsd:element>
							</xsd:sequence>
							<!--L. OBLICZENIE RYCZAŁTU PO ODLICZENIACH OD PRZYCHODÓW-->
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_209" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Przychody objęte ryczałtem zgodnie z art. 12 ust. 1 pkt 4 lit. a ustawy osiągnięte za granicą, o które zwiększona jest podstawa obliczenia ryczałtu do ustalenia stopy procentowej (przeliczone na złote)</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_210" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Przychody objęte ryczałtem zgodnie z art. 12 ust. 1 pkt 4 lit. b-g ustawy osiągnięte za granicą, o które zwiększona jest podstawa obliczenia ryczałtu do ustalenia stopy procentowej (przeliczone na złote)</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Obliczenie ryczałtu po odliczeniach od przychodów</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_211" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>2% kwoty z poz. 196</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_212" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>3% kwoty z poz. 197</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_213" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>5,5% kwoty z poz. 198</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_214" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>8,5% z poz. 199</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_215" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>8,5% z poz. 200</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_216" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>10% kwoty z poz. 201</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_217" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>12% kwoty z poz. 202</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_218" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>12,5% kwoty z poz. 203</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_219" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>12,5% kwoty z poz. 204</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_220" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>14% kwoty z poz. 205</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_221" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>15% kwoty z poz. 206</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_222" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>17% kwoty z poz. 207</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_223" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Ryczałt od przychodów określonych przez organ podatkowy na podstawie art. 17 ustawy</xsd:documentation>
								</xsd:annotation>
								<!--W celu obliczenia ryczałtu od przychodów określonych przez organ podatkowy na podstawie art. 17 ustawy i objętych ryczałtem według różnych stawek należy w pierwszej kolejności przychody wykazane w poz. od 64 do 73 pomniejszyć o przysługujące odliczenia, powiększyć o zwiększenia przypadające na te przychody, pomniejszyć o zmniejszenia przypadające na te przychody, pomniejszyć o wartość nieodliczonych w poprzednich latach wierzytelności i zobowiązań zmniejszających te przychody, zaokrąglić je do pełnych złotych i obliczyć - według właściwych stawek - ryczałt od tych przychodów, a następnie obliczone w ten sposób wielkości zsumować.-->
							</xsd:element>
							<xsd:element name="P_224" type="etd:TKwota2Nieujemna">
								<xsd:annotation>
									<xsd:documentation>Ryczałt</xsd:documentation>
								</xsd:annotation>
								<!--Suma kwot z poz. od 211 do 223.-->
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_225" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Doliczenia do ryczałtu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_226" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>w tym doliczenie wynikające z zastosowania art. 27 ust. 8 ustawy o podatku dochodowym w związku z art. 12 ust. 12 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_227" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatek zapłacony za granicą - zgodnie z art. 27 ust. 9 i 9a ustawy o podatku dochodowym w związku z art. 12 ust. 12 ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_228" type="etd:TKwota2Nieujemna">
								<xsd:annotation>
									<xsd:documentation>Ryczałt</xsd:documentation>
								</xsd:annotation>
								<!--Od sumy kwot z poz. 224 i 225 należy odjąć kwotę z poz. 227. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
							</xsd:element>
							<!--M. ODLICZENIA OD RYCZAŁTU-->
							<!-- -->
							<!--Dokonanie odliczeń od ryczałtu jest możliwe, jeśli z tych samych tytułów podatnik nie dokonywał odliczeń od podatku na podstawie przepisów ustawy o podatku dochodowym.-->
							<xsd:element name="P_229" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Odliczenia - wykazane w części C załącznika PIT/O</xsd:documentation>
								</xsd:annotation>
								<!--Odliczenia nie mogą przekroczyć kwoty z poz. 228.-->
							</xsd:element>
							<xsd:element name="P_230" type="etd:TKwota2Nieujemna">
								<xsd:annotation>
									<xsd:documentation>Ryczałt po odliczeniach</xsd:documentation>
								</xsd:annotation>
								<!--Od kwoty z poz. 228 należy odjąć kwotę z poz. 229.-->
							</xsd:element>
							<xsd:element name="P_231" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Odliczenia mieszkaniowe - wykazane w części C.2. załącznika PIT/D</xsd:documentation>
								</xsd:annotation>
								<!--Odliczenia nie mogą przekroczyć kwoty z poz. 230. Nadwyżka odliczeń ponad kwotę z poz. 230 podlega odliczeniu w następnych latach.-->
							</xsd:element>
							<!--N. OBLICZENIE NALEŻNEGO RYCZAŁTU-->
							<xsd:element name="P_232" type="etd:TKwotaCNieujemna">
								<xsd:annotation>
									<xsd:documentation>Należny ryczałt (po zaokrągleniu do pełnych złotych)</xsd:documentation>
								</xsd:annotation>
								<!--Od kwoty z poz. 230 należy odjąć kwotę z poz. 231.-->
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_233">
									<xsd:annotation>
										<xsd:documentation>Rok podatkowy objęty zwolnieniem, o którym mowa w art. 21 ust. 6 - 13 ustawy</xsd:documentation>
									</xsd:annotation>
									<!--Należy podać rok podatkowy, w którym podatnik korzystał ze zwolnienia, o którym mowa w art. 21 ust. 6-13 ustawy.-->
									<xsd:simpleType>
										<xsd:restriction base="etd:TRok">
											<xsd:minInclusive value="2020"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_234" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>20% należnego ryczałtu wykazanego w zeznaniu składanym za rok podatkowy objęty zwolnieniem, o którym mowa w art. 21 ust. 6 - 13 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<!--O. INFORMACJE O ZWOLNIENIU, O KTÓRYM MOWA W ART. 21 UST. 6-13 USTAWY-->
							<xsd:element name="P_235" type="etd:TWybor1_3" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik korzysta ze zwolnienia w roku podatkowym wykazanym w poz. 4: 1 - tak, od całości przychodów, 2 - tak, od części przychodów, 3 - nie</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<!--P. RYCZAŁT DO ZAPŁATY / NADPŁATA-->
							<!-- -->
							<!--Jeżeli w poz. 235 podatnik zaznaczył kwadrat nr 1, nie wypełnia części P i Q. Jeżeli w poz. 235 podatnik zaznaczył kwadrat nr 2, w częściach P i Q nie wykazuje ryczałtu w części przypadającej na przychody z pozarolniczej działalności gospodarczej, dla których wybrano zwolnienie, o którym mowa w art. 21 ust. 6-13 ustawy.-->
							<xsd:element name="P_236" type="etd:TKwotaCNieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Wpłacony ryczałt</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:choice>
								<xsd:element name="P_237" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>RYCZAŁT DO ZAPŁATY</xsd:documentation>
									</xsd:annotation>
									<!--Od sumy kwot z poz. 232 i 234 należy odjąć kwotę z poz. 236. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
								</xsd:element>
								<xsd:element name="P_238" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>NADPŁATA</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 236 należy odjąć sumę kwot z poz. 232 i 234. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
								</xsd:element>
							</xsd:choice>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Q. Ryczałt obliczony i wykazany w ewidencji przychodów w poszczególnych miesiącach (kwartałach), a także obliczony przez podatnika, o którym mowa w art. 15 ust. 3 ustawy (po dokonanych odliczeniach)</xsd:documentation>
								</xsd:annotation>
								<!--Jeżeli w poz. 235 podatnik zaznaczył kwadrat nr 1, nie wypełnia części P i Q. Jeżeli w poz. 235 podatnik zaznaczył kwadrat nr 2, w częściach P i Q nie wykazuje ryczałtu w części przypadającej na przychody z pozarolniczej działalności gospodarczej, dla których wybrano zwolnienie, o którym mowa w art. 21 ust. 6-13 ustawy.-->
								<xsd:element name="P_239" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Miesiąc I</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_240" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Miesiąc II</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_241" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Miesiąc III / I kwartał</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_242" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Miesiąc IV</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_243" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Miesiąc V</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_244" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Miesiąc VI / II kwartał</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_245" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Miesiąc VII</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_246" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Miesiąc VIII</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_247" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Miesiąc IX / III kwartał</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_248" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Miesiąc X</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_249" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Miesiąc XI</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_250" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Miesiąc XII / IV kwartał</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_251" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>R. Przychody osiągnięte w okresie zawieszenia wykonywania działalności gospodarczej</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<!--W poz. 251 należy wykazać objęte ryczałtem przychody, które zostały ujęte w części D.-->
							<!-- -->
							<!--W poz. 251:
- nie wykazuje się osiągniętych w okresie zawieszenia wykonywania działalności gospodarczej przychodów rozliczanych w tym okresie na podstawie art. 6 ust. 1g ustawy w związku z art. 14c ustawy o podatku dochodowym (metoda kasowa rozliczania przychodów),
- wykazuje się również osiągnięte w okresie zawieszenia wykonywania działalności gospodarczej przychody z odpłatnego zbycia składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy o podatku dochodowym.-->
							<xsd:element name="P_252" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>S. Przychody z odpłatnego zbycia składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy o podatku dochodowym</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<!--W poz. 252 należy wykazać objęte ryczałtem przychody, które zostały ujęte w części D.-->
							<!-- -->
							<!--W poz. 252 nie wykazuje się przychodów z odpłatnego zbycia składników majątku, o których mowa w art. 14 ust. 2 pkt 1 i 19 ustawy o podatku dochodowym, osiągniętych w okresie zawieszenia wykonywania działalności gospodarczej.-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>T. Wniosek o przekazanie 1,5% podatku należnego na rzecz Organizacji Pożytku Publicznego (OPP)</xsd:documentation>
								</xsd:annotation>
								<!--Należy podać numer wpisu do Krajowego Rejestru Sądowego (numer KRS) organizacji wybranej z wykazu prowadzonego na podstawie odrębnych przepisów oraz wysokość kwoty na jej rzecz. W poz. 255 można podać cel szczegółowy 1,5%, a zaznaczając kwadrat w poz. 256, wyrazić zgodę na przekazanie OPP swojego imienia, nazwiska i adresu, wraz z informacją o kwocie z poz. 254.-->
								<xsd:element name="P_253" type="etd:TNrKRS">
									<xsd:annotation>
										<xsd:documentation>Numer KRS</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_254">
									<xsd:annotation>
										<xsd:documentation>Wnioskowana kwota</xsd:documentation>
									</xsd:annotation>
									<!--Kwota z poz. 254 nie może przekroczyć 1,5% kwoty z poz. 232, po zaokrągleniu do pełnych dziesiątek groszy w dół.-->
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:fractionDigits value="1"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_255" type="etd:TZnakowy" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Cel szczegółowy 1,5%</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_256" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Wyrażam zgodę na przekazanie OPP swojego imienia, nazwiska i adresu wraz z informacją o kwocie z poz. 253</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<!--U. DANE KONTAKTOWE-->
							<!-- -->
							<!--W poz. 257 można podać numer telefonu, a w poz. 258 adres e-mail, ułatwiające kontakt z podatnikiem.-->
							<xsd:element name="P_257" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Telefon</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TZnakowy">
										<xsd:maxLength value="16"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_258" type="etd:TAdresEmail" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>E-mail</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<!--V. INFORMACJE O ZAŁĄCZNIKACH-->
							<!-- -->
							<!--W poz. od 259 do 262 należy podać liczbę dołączonych załączników. Poz. 263 i 264 wypełniają podatnicy, którzy załącznik PIT/D dołączyli do innego niż składane zeznanie. Jeżeli w poz. 263 zaznaczono kwadrat nr 2, należy również wypełnić poz. 265.-->
							<xsd:element name="P_259" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załączniku PIT/O</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:choice minOccurs="0">
								<xsd:sequence>
									<xsd:element name="P_260" type="etd:TWybor1">
										<xsd:annotation>
											<xsd:documentation>Informacja o załączniku PIT/D</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_261" type="etd:TWybor1" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Informacja o załączniku PIT-2K</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:element name="P_263" type="etd:TWybor1_2">
										<xsd:annotation>
											<xsd:documentation>Informacja o załączniku - Załącznik PIT/D dołącza do swojego zeznania: 1 - podatnik, 2 - małżonek</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_264" type="etd:TWybor1_3">
										<xsd:annotation>
											<xsd:documentation>Informacja o załączniku - Kod zeznania, do którego został dołączony załącznik PIT/D: 1 - PIT-28, 2 - PIT-36, 3 - PIT-37</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_265" type="etd:TZnakowy" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Informacja o załączniku - Identyfikator podatkowy, nazwisko i imię małżonka oraz urząd, do którego zostało złożone zeznanie z załącznikiem PIT/D</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
							</xsd:choice>
							<xsd:element name="P_262" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załączniku PIT-28/B</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_266" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>W. KARTA DUŻEJ RODZINY (KDR). Podatnik posiada ważną KDR: 1 - tak</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_267" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>X. Informacje dodatkowe. Podatnik wybrał kwartalny sposób opłacania ryczałtu na podstawie art. 21 ust. 1a ustawy: 1 - tak</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_268" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>X. Informacje dodatkowe. podatnik wybrał metodę ustalania daty powstania przychodów na podstawie art. 14 ust. 1j ustawy o podatku dochodowym: 1 - tak</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Y. Rachunek osobisty do zwrotu nadpłaty</xsd:documentation>
								</xsd:annotation>
								<!--Jeżeli z zeznania wynika nadpłata, w tej części można wskazać rachunek bankowy lub rachunek w spółdzielczej kasie oszczędnościowo – kredytowej (SKOK), inny niż związany z prowadzoną działalnością gospodarczą, na który ma nastąpić jej zwrot. Podaje się rachunek, którego posiadaczem (współposiadaczem) jest podatnik. Wskazany rachunek aktualizuje poprzednio zgłoszony rachunek służący do zwrotu podatku lub nadpłaty. Można nie wpisywać rachunku, jeżeli zgłoszony poprzednio jest aktualny.-->
								<xsd:sequence minOccurs="0">
									<xsd:element name="P_269A" type="tns:TKodKrajuWydania">
										<xsd:annotation>
											<xsd:documentation>Kraj siedziby banku (oddziału)</xsd:documentation>
										</xsd:annotation>
										<!--uzupełnić wyłącznie, gdy wskazano rachunek zagraniczny-->
									</xsd:element>
									<xsd:element name="P_271_2" type="tns:SWIFT_Type">
										<xsd:annotation>
											<xsd:documentation>Kod SWIFT</xsd:documentation>
										</xsd:annotation>
										<!--w przypadku rachunku zagranicznego należy podać kod SWIFT-->
									</xsd:element>
								</xsd:sequence>
								<xsd:element name="P_270" type="kw:TKodWaluty" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Waluta, w której jest prowadzony rachunek</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_271_1" type="tns:TNrIBAN">
									<xsd:annotation>
										<xsd:documentation>Pełny numer rachunku - numer IBAN</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Pouczenia">
					<xsd:annotation>
						<xsd:documentation>Wartość 1 oznacza potwierdzenie zapoznania się z treścią i akceptację poniższych pouczeń:
W przypadku niewpłacenia w obowiązujących terminach należności wynikających z poz. 237 i 239-250 lub wpłacenia ich w niepełnej wysokości niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego, zgodnie z art. 3a § 1 pkt 1 ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji.
Za podanie nieprawdy lub zatajenie prawdy i przez to narażenie podatku na uszczuplenie grozi odpowiedzialność przewidziana w Kodeksie karnym skarbowym.
								</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TKwota2Nieujemna">
							<xsd:minExclusive value="0"/>
							<xsd:maxExclusive value="2"/>
							<xsd:fractionDigits value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Zalaczniki" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence minOccurs="0">
							<xsd:element ref="zo28:Zalacznik_PIT_O" minOccurs="0"/>
							<xsd:sequence minOccurs="0">
								<xsd:element ref="zd:Zalacznik_PIT_D"/>
								<xsd:element ref="z2k:Zalacznik_PIT-2K" minOccurs="0"/>
							</xsd:sequence>
							<xsd:element ref="z28b:Zalacznik_PIT-28_B" minOccurs="0"/>
							<xsd:element ref="zzu:Zalacznik_ORD-ZU" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>